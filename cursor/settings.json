{
    "workbench.iconTheme": "Monokai Pro (Filter Ristretto) Icons",
    "editor.renderWhitespace": "all",
    "editor.rulers": [
        80
    ],
    "editor.tabSize": 2,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "files.hotExit": "off",
    "files.exclude": {
        "**/.git": true
    },
    "files.autoSave": "afterDelay",
    "emmet.showSuggestionsAsSnippets": true,
    "emmet.includeLanguages": {
        "erb": "html"
    },
    "rubyLsp.enabledFeatures": {
        "codeActions": true,
        "diagnostics": true,
        "documentHighlights": true,
        "documentLink": true,
        "documentSymbols": true,
        "foldingRanges": true,
        "formatting": true,
        "hover": true,
        "inlayHint": true,
        "onTypeFormatting": true,
        "selectionRanges": true,
        "semanticHighlighting": true,
        "completion": true,
        "codeLens": true,
        "definition": true,
        "workspaceSymbol": true,
        "references": true
    },
    "cmake.configureOnOpen": true,
    "code-runner.runInTerminal": true,
    "editor.stickyScroll.enabled": false,
    "workbench.colorTheme": "Monokai Pro (Filter Ristretto)",
    "editor.accessibilitySupport": "off",
    "extensions.ignoreRecommendations": true,
    "window.autoDetectColorScheme": false,
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "cursor.general.glassShowWarningNotifications": true,
    "cursor.composer.queueMessageDefaultBehavior": "steer"
}
