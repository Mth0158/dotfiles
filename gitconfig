[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  ui = auto

[color "branch"]
  current = green
  remote = yellow

[core]
  pager = delta
  editor = cursor --wait
  excludesfile = ~/.gitignore_global

# delta: syntax-highlighted diffs (https://github.com/dandavison/delta)
[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true # n / N jump between files
  line-numbers = true

[alias]
  co = checkout
  st = status -sb
  br = branch
  ci = commit
  fo = fetch origin
  d = !git --no-pager diff
  dt = difftool
  stat = !git --no-pager diff --stat

  # Default branch: origin/HEAD if known, else main if it exists, else master
  default-branch = "!b=$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null); b=${b#origin/}; [ -n \"$b\" ] || { git show-ref -q --verify refs/heads/main && b=main || b=master; }; echo $b"

  # Clean branches merged into the default branch
  sweep = "!b=$(git default-branch); git branch --merged \"$b\" | grep -vE \"^[*+]|^ +$b$\" | xargs git branch -d; git remote prune origin"

  # http://www.jukie.net/bart/blog/pimping-out-git-log
  lg = log --graph --all --pretty=format:'%Cred%h%Creset - %s %Cgreen(%cr) %C(bold blue)%an%Creset %C(yellow)%d%Creset'

  # Serve local repo. http://coderwall.com/p/eybtga
  # Then other can access via `git clone git://#{YOUR_IP_ADDRESS}/
  serve = !git daemon --reuseaddr --verbose  --base-path=. --export-all ./.git

  m = "!git checkout $(git default-branch)"

  # Removes a file from the index
  unstage = reset HEAD --

[help]
  autocorrect = 1

[init]
  defaultBranch = main

[push]
  default = simple
  autoSetupRemote = true

[fetch]
  prune = true

[merge]
  conflictstyle = zdiff3

[diff]
  algorithm = histogram

[rerere]
  enabled = true

[branch]
  sort = -committerdate

[branch "master"]
  mergeoptions = --no-edit

[branch "main"]
  mergeoptions = --no-edit

[pull]
  rebase = false

[user]
  email = mathieu.eustachy@gmail.com
  name = Mathieu Eustachy

[credential "https://git.heroku.com"]
  helper = !heroku git:credentials

# Written by GitHub Desktop on launch (it bundles git-lfs); keep it to avoid churn
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
